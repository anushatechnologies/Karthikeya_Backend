# ===========================
#  TradeHub B2B Backend — ENV
# ===========================

# Server
PORT=8080
NODE_ENV=development

# MySQL Database (local example)
# For Aiven Cloud, fill in your host/port/user/password from the Aiven console
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tradehub_db
DB_USER=root
DB_PASSWORD=yourpassword
DB_SSL=false      # Set to true for Aiven Cloud / any managed MySQL with SSL

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# File Upload (local)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
