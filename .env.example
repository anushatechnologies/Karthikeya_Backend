# ===========================
#  TradeHub B2B Backend — ENV
# ===========================

# Server
PORT=8080
NODE_ENV=development

# MySQL Database (Aiven Cloud)
# For Aiven Cloud, fill in your host/port/user/password from the Aiven console
# IMPORTANT: These MUST also be set in Vercel Dashboard → Settings → Environment Variables
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tradehub_db
DB_USER=root
DB_PASSWORD=yourpassword
DB_SSL=false      # Set to true for Aiven Cloud / any managed MySQL with SSL

# JWT — IMPORTANT: Use the SAME secret across local, production, and Vercel env vars
JWT_SECRET=tradehub_jwt_b2b_kfpl_prod_secret_2026_xK9mQ7
JWT_EXPIRES_IN=7d

# File Upload — Cloudinary (images & videos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=tradehub
MAX_FILE_SIZE_MB=50

# CORS — comma-separated allowed origins (use * for development)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
